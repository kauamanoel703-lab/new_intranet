# ===== Backend - Variáveis de Ambiente =====
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA commite o `.env` real no repositório.

# Porta onde o servidor Express vai rodar
PORT=3001

# ===== Banco de Dados MySQL =====
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=intranet_jucepe

# ===== Segurança =====
# IMPORTANTE: troque por uma string aleatória longa (>= 32 caracteres) em produção.
# Sugestão para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jucepe_troque_esta_chave_em_producao_use_uma_string_aleatoria_de_pelo_menos_32_caracteres

# ===== CORS =====
# Lista de origens permitidas separadas por vírgula.
# Em produção, troque para o domínio real do frontend.
FRONTEND_ORIGIN=http://localhost:5173
